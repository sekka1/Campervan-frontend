# DeepSeek Model Configuration
# Easily change the model identifier as new versions or cheaper models are released.
DEEPSEEK_MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017"

# DEEPINFRA_TOKEN: DeepInfra API key for inference.
# Configured in Cloudflare Worker Secrets (Runtime variables & secrets) for production,
# or in a local .env file for local development.
DEEPINFRA_TOKEN="YOUR_DEEPINFRA_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
